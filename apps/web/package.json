{
  "name": "@blueprint/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "generate": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "tsr generate && eslint src --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@blueprint/shared": "workspace:*",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.65",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@blueprint/eslint-config": "workspace:*",
    "@blueprint/testing-config": "workspace:*",
    "@blueprint/typescript-config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@tanstack/router-cli": "^1.166.43",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "vite": "^7.3.3",
    "vitest": "^4.1.5"
  }
}

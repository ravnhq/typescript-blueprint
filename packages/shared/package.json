{
  "name": "@blueprint/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:unit": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.config.ts --reporter=verbose src/boundary",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "neverthrow": "^8.2.0",
    "remeda": "^2.34.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@blueprint/eslint-config": "workspace:*",
    "@blueprint/testing-config": "workspace:*",
    "@blueprint/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.6",
    "vitest": "^4.1.6"
  }
}

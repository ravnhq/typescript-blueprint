{
  "name": "typescript-blueprint",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "test:ai-tooling": "node scripts/check-ai-tooling.mjs",
    "verify": "turbo run lint typecheck test:unit format:check && node scripts/check-ai-tooling.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,cts,js,mjs,cjs}\" --ignore-path .gitignore",
    "dev": "turbo dev",
    "prepare": "husky && ruler apply"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/types": "^21.0.1",
    "@intellectronica/ruler": "^0.3.40",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.7.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "h3": ">=2.0.1-rc.18"
    }
  }
}
